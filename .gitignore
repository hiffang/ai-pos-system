# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build outputs ────────────────────────────────────────────────────────────
# electron-builder packaged output
dist-electron/
# Vite production build and dev cache
client/dist/
client/.vite/

# ─── Database ─────────────────────────────────────────────────────────────────
prisma/pos.db
prisma/pos.db-journal
prisma/pos.db-shm
prisma/pos.db-wal
*.db
*.db-journal
*.db-shm
*.db-wal

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
jwt-secret.txt

# ─── AI models (large binary files — store in Git LFS or distribute separately)
ai/models/**/*.onnx
ai/models/**/*.tflite
ai/models/**/*.pmml
# Keep manifests and the active.json pointer
!ai/models/**/manifest.json
!ai/models/active.json

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
electron.log

# ─── OS & editor artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Testing & coverage ───────────────────────────────────────────────────────
coverage/
.jest-cache/

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Keep migrations and schema — never ignore these
# !prisma/migrations/
# !prisma/schema.prisma

# ─── Misc ─────────────────────────────────────────────────────────────────────
.npmrc.local
.cache/
tmp/
.gitignore