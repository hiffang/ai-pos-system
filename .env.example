DATABASE_URL="file:./pos.db"
JWT_SECRET=change-this-to-a-random-string
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# AI insight generation via Claude API (optional — insights fall back to
# the last cached narrative when offline or when this key is not set).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# How many hours before a cached insight is considered stale (default: 12)
AI_INSIGHT_MAX_AGE_HOURS=12

PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
ONEPAY_APP_ID=
ONEPAY_APP_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
