// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role values: CASHIER | MANAGER | ADMIN
// PaymentMethod values: CASH | CARD | WALLET | QR | BANK_TRANSFER
// PaymentStatus values: PENDING | COMPLETED | FAILED | QUEUED
// Stored as String because SQLite has no native enum support; validation is enforced in app code.

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("CASHIER")
  orders       Order[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String
  products    Product[]
}

model Product {
  id               String         @id @default(uuid())
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  name             String
  sku              String         @unique
  barcode          String?        @unique
  priceLKR         Decimal
  stockQty         Int
  reorderThreshold Int            @default(10)
  orderItems       OrderItem[]
  inventoryLogs    InventoryLog[]
  updatedAt        DateTime       @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  totalLKR      Decimal
  status        String      @default("PENDING")
  items         OrderItem[]
  payment       Payment?
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPriceLKR Decimal
}

model Payment {
  id           String    @id @default(uuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])
  method       String
  status       String    @default("PENDING")
  amountLKR    Decimal
  changeLKR    Decimal?
  gatewayRef   String?
  bankRef      String?
  walletRef    String?
  qrPayload    String?
  customerName String?
  synced       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  settledAt    DateTime?
}

model InventoryLog {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  qtyChange Int
  reason    String
  loggedAt  DateTime @default(now())
}

model Outbox {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  operation String
  payload   String
  synced    Boolean  @default(false)
  retries   Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metadata  String?
  createdAt DateTime @default(now())
}

// LLM-generated narrative insight cached locally.
// inputHash detects when the underlying forecast data has changed so we only
// call the API when the numbers are actually different, not just because time
// has passed.  One non-stale row is the "active" insight shown in the UI.
model AIInsight {
  id          String   @id @default(uuid())
  narrative   String
  modelUsed   String   @default("claude-sonnet-4-6")
  inputHash   String
  generatedAt DateTime @default(now())
  stale       Boolean  @default(false)
}
